[Unit]
Description=Forex Autonomous Signal Daemon (Traders Family Monetization Engine)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ihza
WorkingDirectory=/home/ihza/Projects/forex
ExecStart=/home/ihza/Projects/forex/target/release/signal-daemon
Restart=always
RestartSec=5s
Environment=RUST_LOG=info
EnvironmentFile=-/home/ihza/Projects/forex/.env

# Security sandbox
ProtectHome=read-only
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
