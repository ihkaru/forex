# ==============================================================================
# STAGE 1: Build Svelte 5 + Vite Production Bundle using Bun v1.4.2
# ==============================================================================
FROM oven/bun:1.4.2-alpine AS builder
WORKDIR /app

# Install dependencies using Bun frozen lockfile
COPY ui/package.json ui/bun.lock ./
RUN bun install --frozen-lockfile

# Copy frontend source code and compile using Bun
COPY ui/ ./
RUN bun run build

# ==============================================================================
# STAGE 2: High-Performance Nginx Alpine Runtime
# ==============================================================================
FROM nginx:alpine AS runtime
WORKDIR /usr/share/nginx/html

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with reverse proxy & websocket support
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
