# ==============================================================================
# 🔐 TRADERS FAMILY QUANT ENGINE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` dan isi dengan kredensial akun analis Anda.
# ==============================================================================

# Token Autentikasi Aplikasi Traders Family (Didapat dari reverse engineering sesi login)
TF_AUTH_TOKEN=your_traders_family_jwt_token_here

# Channel ID Tujuan di Aplikasi Traders Family
TF_CHANNEL_ID=tf_priority_quant_channel

# Notifikasi Cadangan Telegram (Opsional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-100123456789

# Database PostgreSQL / TimescaleDB (Opsional untuk OLTP Storage)
DATABASE_URL=postgres://forex_user:forex_password@localhost:5432/forex_quant
